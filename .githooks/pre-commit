#!/bin/sh
# Git pre-commit hook: runs the hooks in .pre-commit-config.yaml on the staged
# changes. Enabled with `git config core.hooksPath .githooks` (see
# README.md, "Working on the template").
#
# The same hook generated projects get (template/.githooks/pre-commit):
# committed, not generated by `pre-commit install`, so it isn't tied to one
# Python environment. The template repo has no virtualenv, so this normally
# runs pre-commit through uvx.

# GUI Git clients (GitHub Desktop, IDEs) often don't inherit the login shell's
# PATH, so also look where uv's installer puts uv/uvx. Appended, so anything
# already on PATH still wins.
PATH="$PATH:$HOME/.local/bin:$HOME/.cargo/bin"

if command -v pre-commit >/dev/null 2>&1; then
    exec pre-commit run --hook-stage pre-commit
elif command -v uvx >/dev/null 2>&1; then
    # Keep in step with template/pyproject.toml.jinja and template-ci.yml.
    # --python: the template's python_version (copier.yml). The hooks' Python
    # envs use this interpreter, and Semgrep's deps may lack wheels for a
    # newer one.
    exec uvx --python 3.14 --from 'pre-commit>=4.6,<5' pre-commit run --hook-stage pre-commit
else
    echo "pre-commit hook: neither pre-commit nor uv was found on PATH." >&2
    echo "Install uv (https://docs.astral.sh/uv/) and commit again." >&2
    exit 1
fi
