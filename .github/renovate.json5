// Renovate — keeps the versions pinned in this template current, so new
// projects don't start out stale. (Generated GitHub projects use Dependabot,
// see template/.github/dependabot.yml; Azure DevOps projects get new pins with
// `copier update`. This file is for the template repo only.)
//
// Renovate rather than Dependabot here because most pins live in `.jinja` files
// (ci.yml.jinja, release.yml.jinja, pyproject.toml.jinja, ...), which
// Dependabot can't be pointed at. Renovate's managers take extra file patterns,
// and regex managers cover the pins no manager knows about.
//
// Every update PR runs Template CI, which generates projects from the branch
// and runs their checks, so a bump that breaks new projects fails there.
//
// Policy mirrors template/.github/dependabot.yml: weekly, a 7-day release-age
// cooldown, grouped updates, and Conventional Commit PR titles
// ("ci(deps): ..." / "build(deps): ...") that pass the PR Title check.
{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["config:recommended"],

  // Before Template CI's Monday 13:00 UTC run.
  schedule: ["* 0-12 * * 1"],
  // Wait 7 days after a release before proposing it: hijacked releases are
  // usually caught and pulled within days. "strict" holds the PR back until
  // then, rather than opening it with a pending check.
  minimumReleaseAge: "7 days",
  internalChecksFilter: "strict",

  semanticCommits: "enabled",
  semanticCommitType: "ci",
  semanticCommitScope: "deps",

  "github-actions": {
    // The defaults already cover .github/workflows/*.yml at the root and under
    // template/; add the rendered workflows.
    managerFilePatterns: ["/^template/\\.github/workflows/[^/]+\\.ya?ml\\.jinja$/"],
  },

  customManagers: [
    {
      // Hooks pinned as `rev: <sha> # frozen: vX.Y.Z` (pre-commit autoupdate
      // --freeze style), in the root config and the template's. Renovate's own
      // pre-commit manager doesn't keep the SHA and the comment in step.
      customType: "regex",
      description: "pre-commit hook revs frozen to a SHA",
      managerFilePatterns: ["/(^|/)\\.pre-commit-config\\.ya?ml(\\.jinja)?$/"],
      matchStrings: [
        "repo: https://github\\.com/(?<depName>[^/\\s]+/[^/\\s]+)\\n\\s+rev: (?<currentDigest>[0-9a-f]{40}) # frozen: (?<currentValue>\\S+)",
      ],
      datasourceTemplate: "github-tags",
    },
    {
      // Dev dependency ranges in the generated pyproject.toml. The pep621
      // manager can't read the .jinja file: `[[ project_name ]] = ...` isn't
      // valid TOML until rendered.
      customType: "regex",
      description: "Python dev dependencies in pyproject.toml.jinja",
      managerFilePatterns: ["/^template/pyproject\\.toml\\.jinja$/"],
      matchStrings: ['\\n\\s+"(?<depName>[A-Za-z0-9._-]+)(?<currentValue>[<>=!~][^"]*)",'],
      datasourceTemplate: "pypi",
      versioningTemplate: "pep440",
    },
    {
      // The Trivy release trivy-action installs (`version:` input).
      customType: "regex",
      description: "Trivy version in the generated workflows",
      managerFilePatterns: ["/^template/\\.github/workflows/[^/]+\\.ya?ml\\.jinja$/"],
      matchStrings: ["trivy-config: trivy\\.yaml\\n\\s+version: (?<currentValue>v\\S+)"],
      depNameTemplate: "aquasecurity/trivy",
      datasourceTemplate: "github-releases",
    },
    {
      // The cosign release the generated Azure Pipelines CI installs to verify
      // Betterleaks. Its cosignSha256 can't be computed by Renovate: the PR
      // fails Template CI's cosign pin check until you push the new sha256 (of
      // cosign-linux-amd64, from the release's cosign_checksums.txt) to the
      // branch.
      customType: "regex",
      description: "cosign release in the generated Azure Pipelines CI",
      managerFilePatterns: ["/^template/[^/]*azure-pipelines\\.yml[^/]*\\.jinja$/"],
      matchStrings: ["cosignRelease: (?<currentValue>v\\S+)"],
      depNameTemplate: "sigstore/cosign",
      datasourceTemplate: "github-releases",
    },
    {
      // The uv release the Azure Pipelines CI and the dev container install.
      // Both read GitHub releases, so both get the same version after the same
      // 7-day wait, in one PR (the "uv" group below).
      customType: "regex",
      description: "uv version in the generated Azure Pipelines CI and dev container",
      managerFilePatterns: [
        "/^template/[^/]*azure-pipelines\\.yml[^/]*\\.jinja$/",
        "/^template/\\.devcontainer/Dockerfile\\.jinja$/",
      ],
      matchStrings: ["uvRelease: (?<currentValue>\\S+)", 'ARG uvRelease="(?<currentValue>[^"]+)"'],
      depNameTemplate: "astral-sh/uv",
      datasourceTemplate: "github-releases",
    },
    {
      // Trivy's installer in the Azure Pipelines CI, fetched at a release's
      // commit: the SHA and the version passed to it move together.
      customType: "regex",
      description: "Trivy version in the generated Azure Pipelines CI",
      managerFilePatterns: ["/^template/[^/]*azure-pipelines\\.yml[^/]*\\.jinja$/"],
      matchStrings: [
        "aquasecurity/trivy/(?<currentDigest>[0-9a-f]{40})/contrib/install\\.sh \\\\\\n\\s+\\| sh -s -- -b \\S+ (?<currentValue>v\\S+)",
      ],
      depNameTemplate: "aquasecurity/trivy",
      datasourceTemplate: "github-tags",
    },
    {
      // Dev container features. A regex rather than Renovate's devcontainer
      // manager, which parses the file as JSONC: the `platform` blocks around
      // the CLI features make devcontainer.json.jinja unparseable, and the
      // manager would then skip the file without an error.
      customType: "regex",
      description: "Dev container features",
      managerFilePatterns: ["/^template/\\.devcontainer/devcontainer\\.json\\.jinja$/"],
      matchStrings: ['"(?<depName>ghcr\\.io/devcontainers/features/[^":]+):(?<currentValue>[^"]+)"'],
      datasourceTemplate: "docker",
    },
    {
      // The devcontainer CLI Template CI builds containers with.
      customType: "regex",
      description: "devcontainer CLI in Template CI",
      managerFilePatterns: ["/^\\.github/workflows/template-ci\\.yml$/"],
      matchStrings: ["@devcontainers/cli@(?<currentValue>\\d+\\.\\d+\\.\\d+)"],
      depNameTemplate: "@devcontainers/cli",
      datasourceTemplate: "npm",
    },
  ],

  packageRules: [
    {
      // config:recommended's :semanticPrefixFixDepsChoreOthers sets "chore"
      // for every package in a packageRule, which beats the top-level
      // semanticCommitType; "chore" doesn't cut a template release.
      matchPackageNames: ["*"],
      semanticCommitType: "ci",
    },
    {
      // The dev container's base image: Renovate fills ${VARIANT} in from
      // `ARG VARIANT="[[ python_version ]]-trixie"`, so the tag it sees is
      // Jinja, not a real one. The image follows python_version anyway.
      matchManagers: ["dockerfile"],
      matchFileNames: ["template/.devcontainer/Dockerfile.jinja"],
      matchDepNames: ["mcr.microsoft.com/devcontainers/python"],
      enabled: false,
    },
    {
      // The dev container's and the Azure Pipelines CI's uvRelease in one PR,
      // so both run the same uv.
      matchPackageNames: ["astral-sh/uv"],
      groupName: "uv",
    },
    {
      matchManagers: ["github-actions"],
      groupName: "GitHub Actions",
    },
    {
      matchManagers: ["custom.regex"],
      matchDatasources: ["github-tags"],
      groupName: "pre-commit hooks",
    },
    {
      // Minor/patch bumps together; majors stay separate PRs so breaking
      // changes get their own review.
      matchDatasources: ["pypi"],
      semanticCommitType: "build",
      matchUpdateTypes: ["minor", "patch"],
      groupName: "Python dev dependencies",
    },
    {
      matchDatasources: ["pypi"],
      semanticCommitType: "build",
    },
    {
      // trivy-action's `version:` (GitHub) and the installer pin (Azure
      // DevOps) in one PR, so both platforms scan with the same Trivy.
      matchPackageNames: ["aquasecurity/trivy"],
      groupName: "Trivy",
    },
    {
      // The root and template hook revs, in one PR. CI reads its version from
      // the hook, so nothing else moves with them.
      matchPackageNames: ["betterleaks/betterleaks"],
      groupName: "Betterleaks",
    },
  ],
}
