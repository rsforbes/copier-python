{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "DISABLE_ERROR_REPORTING": "1"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Bash(uv run pytest:*)",
      "Bash(uv run ruff:*)",
      "Bash(uv run pre-commit run:*)",
      "Bash(uv sync:*)",
      "Bash(uv lock:*)",
      "Read",
      "Glob",
      "Grep",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git blame *)",
      "Bash(git ls-files *)",
      "Bash(git rev-parse *)",
      "Bash(git branch --show-current)",
      "Bash(git remote -v)",
      "Bash(git fetch *)",
      "Bash(git worktree list *)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr status *)",
      "Bash(gh run view *)",
      "Bash(gh run list *)",
      "Bash(gh run watch *)",
      "Bash(gh issue view *)",
      "Bash(gh issue list *)",
      "Bash(gh repo view *)",
      "Bash(gh release view *)",
      "Bash(gh release list *)",
      "Bash(az repos pr list *)",
      "Bash(az repos pr show *)",
      "Bash(az pipelines runs list *)",
      "Bash(az pipelines runs show *)",
      "mcp__github__get_file_contents",
      "mcp__github__get_commit",
      "mcp__github__list_commits",
      "mcp__github__list_branches",
      "mcp__github__list_pull_requests",
      "mcp__github__pull_request_read",
      "mcp__github__search_pull_requests",
      "mcp__github__list_issues",
      "mcp__github__issue_read",
      "mcp__github__search_issues",
      "mcp__github__search_code",
      "mcp__github__list_releases",
      "mcp__github__get_latest_release"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.env)",
      "Read(**/.envrc)",
      "Read(**/secrets/**)",
      "Read(~/.ssh/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.aws/**)",
      "Read(~/.config/gcloud/**)",
      "Read(~/.azure/**)",
      "Read(~/.netrc)",
      "Read(~/.pypirc)",
      "Read(~/.docker/config.json)",
      "Read(!**/.env.example)"
    ],
    "ask": [
      "Bash(git commit *)",
      "Bash(git * commit)",
      "Bash(git * commit *)",
      "Bash(git push *)",
      "Bash(git * push)",
      "Bash(git * push *)",
      "Bash(git reset --hard *)",
      "Bash(git * reset --hard)",
      "Bash(git * reset --hard *)",
      "Bash(git clean *)",
      "Bash(git * clean)",
      "Bash(git * clean *)",
      "Bash(git checkout *)",
      "Bash(git * checkout)",
      "Bash(git * checkout *)",
      "Bash(git restore *)",
      "Bash(git * restore)",
      "Bash(git * restore *)",
      "Bash(git branch -D *)",
      "Bash(git * branch -D)",
      "Bash(git * branch -D *)",
      "Bash(git stash drop *)",
      "Bash(git * stash drop)",
      "Bash(git * stash drop *)",
      "Bash(git stash clear *)",
      "Bash(git * stash clear)",
      "Bash(git * stash clear *)",
      "Bash(git rebase *)",
      "Bash(git * rebase)",
      "Bash(git * rebase *)",
      "Bash(gh pr create *)",
      "Bash(gh pr merge *)",
      "Bash(gh pr close *)",
      "Bash(gh release create *)",
      "Bash(gh release delete *)",
      "Bash(gh repo delete *)",
      "Bash(az repos pr create *)",
      "Bash(az repos pr update *)",
      "Bash(az repos delete *)",
      "mcp__github__create_pull_request",
      "mcp__github__merge_pull_request"
    ]
  },
  "enabledPlugins": {
    "security-guidance@claude-plugins-official": true
  }
}
