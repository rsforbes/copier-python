# Release — versioning, changelog, and GitHub releases via release-please
# (https://github.com/googleapis/release-please).
#
# On every push to main, release-please reads the Conventional Commit subjects
# merged since the last release (squash-merged PR titles, see CONTRIBUTING.md)
# and keeps a single "chore(main): release X.Y.Z" pull request open. That PR
# bumps the version in pyproject.toml and uv.lock and prepends the generated
# notes to CHANGELOG.md. `feat` bumps the minor version, `fix`/`perf` the patch,
# and `!` / `BREAKING CHANGE:` the major. Merging the PR tags vX.Y.Z, creates
# the GitHub release, and the jobs below build the sdist and wheel and attach
# them to it, so the project can be installed with e.g.
#   uv pip install https://github.com/[[ github_owner ]]/[[ project_name ]]/releases/download/vX.Y.Z/<wheel>
# or straight from the tag with `git+https://...@vX.Y.Z`.
# Settings: release-please-config.json; current version:
# .release-please-manifest.json.
#
# Token: release-please uses a GitHub App when the RELEASE_APP_CLIENT_ID and
# RELEASE_APP_PRIVATE_KEY secrets are set (the app needs Contents, Pull
# requests, and Issues read/write). Otherwise it falls back to GITHUB_TOKEN,
# which needs "Allow GitHub Actions to create and approve pull requests"
# enabled under Settings > Actions > General. The catch with GITHUB_TOKEN:
# pull requests it opens don't trigger workflows, so the release PR gets no CI
# run. That's fine without required status checks; once branch protection
# requires "CI", set up the app.
#
# Building and releasing are separate jobs so the job holding contents: write
# runs no project code.

name: Release

on:
  push:
    branches: [main]

permissions: {}

# Never run two release-please passes at once (they'd race on the release PR),
# and never cancel one mid-release.
concurrency:
  group: release
  cancel-in-progress: false

jobs:
  release-please:
    name: Release PR / tag
    runs-on: ubuntu-latest
    permissions:
      # Used only by the GITHUB_TOKEN fallback; the app brings its own.
      contents: write
      pull-requests: write
      issues: write
    env:
      RELEASE_APP_CLIENT_ID: ${{ secrets.RELEASE_APP_CLIENT_ID }}
    outputs:
      release_created: ${{ steps.release.outputs.release_created }}
      tag_name: ${{ steps.release.outputs.tag_name }}
    steps:
      - name: Get GitHub App token
        id: app-token
        if: ${{ env.RELEASE_APP_CLIENT_ID != '' }}
        uses: actions/create-github-app-token@bcd2ba49218906704ab6c1aa796996da409d3eb1 # v3.2.0
        with:
          client-id: ${{ secrets.RELEASE_APP_CLIENT_ID }}
          private-key: ${{ secrets.RELEASE_APP_PRIVATE_KEY }}
          permission-contents: write
          permission-pull-requests: write
          permission-issues: write
      - uses: googleapis/release-please-action@45996ed1f6d02564a971a2fa1b5860e934307cf7 # v5.0.0
        id: release
        with:
          token: ${{ steps.app-token.outputs.token || github.token }}
          config-file: release-please-config.json
          manifest-file: .release-please-manifest.json

  build:
    name: Build distributions
    needs: release-please
    if: ${{ needs.release-please.outputs.release_created == 'true' }}
    runs-on: ubuntu-latest
    permissions:
      contents: read
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false
          ref: ${{ needs.release-please.outputs.tag_name }}
      - uses: astral-sh/setup-uv@1c37ad07a6a961277cf70c0d37d6f313000f5884 # v10.3.0
        with:
          python-version: '[[ python_version ]]'
          # No cache in a release build: a cache written by another workflow
          # could otherwise inject content into the released artifacts.
          enable-cache: false
      - name: Build sdist and wheel
        run: uv build
      - uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9 # v7.0.2
        with:
          name: dist
          path: dist/
          if-no-files-found: error

  upload-release-assets:
    name: Attach distributions to GitHub release
    needs: [release-please, build]
    runs-on: ubuntu-latest
    permissions:
      contents: write # upload release assets
    steps:
      - uses: actions/download-artifact@9000827ccba6bdab643e8b6fd33ac0654aef8333 # v8.0.2
        with:
          name: dist
          path: dist/
      - name: Upload to release
        env:
          GH_TOKEN: ${{ github.token }}
          GH_REPO: ${{ github.repository }}
          TAG: ${{ needs.release-please.outputs.tag_name }}
        # --clobber: a re-run after a partial upload replaces the assets
        # instead of failing on "already exists".
        run: gh release upload --clobber "$TAG" dist/*
