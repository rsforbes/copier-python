[% from 'partials/ci.jinja' import betterleaks_resolve, betterleaks_install, trivy_gate -%]
# CI — lint, run the test suite, and guard the declared dependency floor.
#
# The project targets a single Python version, [[ python_version ]] (the
# template's `python_version`; the dev container uses the same one). To move
# to a newer Python, bump it in the template and run `copier update`, which
# updates this file, requires-python, the classifiers, ruff's target-version,
# and the dev container together.
#
# `lowest-direct` installs the *lowest* versions allowed by our direct
# dependency constraints (uv --resolution lowest-direct) and runs the suite, so
# a dependency floor that's too low fails here instead of in an install.
#
# Security scanning:
# - `pre-commit` runs every hook in .pre-commit-config.yaml (Semgrep SAST,
#   actionlint, zizmor) over the whole tree, so CI enforces exactly what the
#   local hooks check.
# - `betterleaks` scans the full git history for secrets (the local hook only
#   sees staged changes).
# - `trivy` scans uv.lock for vulnerable dependencies and the Dockerfile for
#   misconfigurations (config in trivy.yaml). On a pull request it fails only
#   on findings the base branch lacks, so a newly published advisory doesn't
#   fail every open PR at once.
# Trivy and Semgrep also run weekly and on every push to main (security.yml),
# which uploads their findings to the Security tab and opens an issue when a
# run fails.
#
# Every action is pinned to a full commit SHA (tag in a trailing comment), not
# a mutable tag: in March 2026 an attacker repointed 76 of trivy-action's 77
# tags at credential-stealing code. Dependabot keeps the SHAs current.
#
# `ci` is an aggregate gate job: make THIS the required status check in branch
# protection. It reports a single stable name ("CI") regardless of how many jobs
# or matrix legs exist, so changing them never breaks branch protection config.

name: CI

on:
  pull_request:
  workflow_dispatch:

permissions:
  contents: read

jobs:
  lint:
    name: Lint (ruff)
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false
      - uses: astral-sh/setup-uv@68559e99cc807c1eb7e9238fd43a15bba460eec2 # v10.3.3
        with:
          python-version: '[[ python_version ]]'
      # --locked fails when uv.lock is out of date with pyproject.toml
      # (--frozen would install the stale lock and `uv run` would re-lock).
      - name: Install dependencies
        run: uv sync --locked --all-extras
      - name: Ruff format check
        run: uv run ruff format --check .
      - name: Ruff lint
        run: uv run ruff check .

  test:
    name: Test
    needs: lint
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false
      - uses: astral-sh/setup-uv@68559e99cc807c1eb7e9238fd43a15bba460eec2 # v10.3.3
        with:
          python-version: '[[ python_version ]]'
      # --locked fails when uv.lock is out of date with pyproject.toml
      # (--frozen would install the stale lock and `uv run` would re-lock).
      - name: Install dependencies
        run: uv sync --locked --all-extras
[%- if flavor == 'browser' %]
      # Playwright's browser isn't a Python package, so `uv sync` leaves it
      # out. The cache holds the download (keyed on the lockfile, which pins
      # the Playwright version); --with-deps still apt-installs the libraries
      # Chromium needs on each run.
      - name: Cache Playwright browsers
        uses: actions/cache@55cc8345863c7cc4c66a329aec7e433d2d1c52a9 # v6.1.0
        with:
          path: ~/.cache/ms-playwright
          key: playwright-locked-${{ runner.os }}-${{ hashFiles('uv.lock') }}
      - name: Install Playwright's Chromium
        run: uv run --no-sync playwright install --with-deps chromium
[%- endif %]
      - name: Test
        run: uv run pytest

  lowest-direct:
    name: Test (lowest-direct floor)
    needs: lint
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false
      - uses: astral-sh/setup-uv@68559e99cc807c1eb7e9238fd43a15bba460eec2 # v10.3.3
        with:
          python-version: '[[ python_version ]]'
      - name: Install lowest allowed direct dependencies
        run: uv sync --resolution lowest-direct --all-extras
[%- if flavor == 'browser' %]
      # Playwright's browser isn't a Python package, so `uv sync` leaves it
      # out. The cache holds the download (keyed on the lockfile, which pins
      # the Playwright version); --with-deps still apt-installs the libraries
      # Chromium needs on each run.
      - name: Cache Playwright browsers
        uses: actions/cache@55cc8345863c7cc4c66a329aec7e433d2d1c52a9 # v6.1.0
        with:
          path: ~/.cache/ms-playwright
          key: playwright-lowest-direct-${{ runner.os }}-${{ hashFiles('uv.lock') }}
      - name: Install Playwright's Chromium
        run: uv run --no-sync playwright install --with-deps chromium
[%- endif %]
      # --no-sync: a plain `uv run` would re-lock at the default (highest)
      # resolution and reinstall, testing the newest versions instead.
      - name: Test
        run: uv run --no-sync pytest

  pre-commit:
    name: Pre-commit hooks
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false
      - uses: astral-sh/setup-uv@68559e99cc807c1eb7e9238fd43a15bba460eec2 # v10.3.3
        with:
          python-version: '[[ python_version ]]'
      # Only the dev group (pre-commit itself): the hooks run in their own
      # environments, so the package and its runtime deps aren't needed.
      - name: Install dependencies
        run: uv sync --frozen --only-dev
      # The Python hook envs (Semgrep, zizmor) link to this interpreter, so the
      # cache key includes its version: otherwise a Python patch bump restores
      # broken envs that pre-commit rebuilds on every run, and an exact key hit
      # never re-saves the cache.
      - name: Get Python version
        id: python
        run: echo "version=$(uv run --frozen --only-dev python -c 'import sys; print(sys.version.split()[0])')" >> "$GITHUB_OUTPUT"
      - name: Cache hook environments
        uses: actions/cache@55cc8345863c7cc4c66a329aec7e433d2d1c52a9 # v6.1.0
        with:
          path: ~/.cache/pre-commit
          key: pre-commit-${{ runner.os }}-py${{ steps.python.outputs.version }}-${{ hashFiles('.pre-commit-config.yaml') }}
      # The betterleaks hook only scans staged changes, so it has nothing to do
      # here; the `betterleaks` job below scans the full history instead.
      - name: Run hooks on all files
        run: uv run --frozen --only-dev pre-commit run --all-files --show-diff-on-failure
        env:
          SKIP: betterleaks
          # Enables zizmor's online audits (e.g. that each pinned SHA belongs to
          # the repo it claims). Read-only: the workflow grants contents: read.
          GH_TOKEN: ${{ github.token }}

  betterleaks:
    name: Secrets (Betterleaks)
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false
          fetch-depth: 0 # full history: a secret removed in a later commit is still leaked

      # The version is read from the betterleaks hook in .pre-commit-config.yaml
      # rather than written here, so the commit-time hook and this scan cannot
      # drift onto different versions. The hook pins a commit SHA with its tag
      # in the `# frozen:` comment; the step checks that the tag still names
      # that commit, so an edit to one without the other fails here.
      # Dependabot's pre-commit ecosystem bumps both.
      - name: Resolve the betterleaks version from the pre-commit config
        id: betterleaks
        run: |[[- betterleaks_resolve(error='::error::', output='echo "rev=$rev" >> "$GITHUB_OUTPUT"') ]]

      # Installed from the published release binary rather than run as a
      # container image. Three reasons, in order of weight:
      #
      # The archive is verified by signature, so what executes is the binary
      # betterleaks' own release workflow built for this tag, and nothing else.
      # This is the one piece of third-party code that reads the entire tree
      # and full history. betterleaks publishes immutable releases (assets
      # and tag cannot change after publishing) and signs checksums.txt with
      # Sigstore from .github/workflows/release.yml. Checking that signature
      # against the exact tag's workflow identity rejects a checksums.txt that
      # anyone else produced — a stolen upload token included — and the
      # archive is then checked against the signed checksums. This needs no
      # hand edit per release, so a Dependabot bump of the pre-commit rev
      # passes on its own and no person reviews the new binary, which is
      # accepted on purpose. Two things guard it: the Dependabot cooldown on
      # the pre-commit ecosystem (a bad release usually surfaces within the
      # window) and this signature (only betterleaks' release workflow can
      # produce one).
      #
      # `gh release verify-asset` was considered: it needs no extra tool, but
      # GitHub's release attestation only proves the file was published in a
      # betterleaks release, which a stolen token can also do. The Sigstore
      # identity proves which workflow built it.
      #
      # cosign fetches Sigstore's trusted root online, so a Sigstore outage
      # fails this job. That is the right way to fail for a security gate; a
      # re-run once Sigstore recovers clears it.
      #
      # It is the same delivery the pre-commit hook uses (a Go binary), so the
      # commit-time scan and this one are one mechanism rather than two.
      #
      # And the scan itself runs anywhere the binary does. The dev container
      # has no cosign, so to reproduce a CI result there, install the same
      # release and run the Scan step's command; verification is CI's job.
      - name: Install cosign
        uses: sigstore/cosign-installer@756fe2d284c7292c4e9b62c8a28f1e5629c59532 # v4.1.3

      - name: Install betterleaks
        env:
          REV: ${{ steps.betterleaks.outputs.rev }}
        run: |[[- betterleaks_install(error='::error::', tmp='$RUNNER_TEMP') ]]

      # Suppressions are read from main, never from the code under scan, so a
      # change cannot quietly suppress its own finding: a new allowlist entry or
      # ignored fingerprint reaches main in a pull request of its own first.
      # (A change to this workflow or to the scanner's version can still alter
      # the scan; that is a security change, reviewed as one.) That holds for
      # every run of this job, whatever triggered it, stacked pull requests
      # included. The checkout's own files are replaced with
      # main's before the scan, because betterleaks reads an ignore file from
      # the scan target whatever -i names (.betterleaksignore, or failing that
      # .gitleaksignore), and loads a .betterleaks.toml from it when given no
      # --config before 1.10.0. Where main lacks a file, the scan uses the
      # default rules alone, or ignores nothing. The scan also ignores inline
      # betterleaks:allow comments (--ignore-gitleaks-allow below), which a
      # change could add on any line.
      - name: Replace the suppression files with main's
        env:
          REPO: ${{ github.repository }}
          GH_TOKEN: ${{ github.token }}
        run: |
          # The checkout's own files are still scanned for secrets, as plain
          # content: copied aside under names betterleaks doesn't treat as
          # policy, and checked with main's config at the end of this step.
          submitted="$RUNNER_TEMP/submitted"
          mkdir -p "$submitted"
          for f in .betterleaks.toml .betterleaksignore .gitleaksignore; do
            if [ -f "$f" ]; then cp "$f" "$submitted/${f#.}.txt"; fi
          done
          rm -f .betterleaks.toml .betterleaksignore .gitleaksignore
          # .gitleaksignore is read only where main has no .betterleaksignore,
          # as betterleaks itself reads it.
          for f in .betterleaks.toml .betterleaksignore .gitleaksignore; do
            if [ "$f" = .gitleaksignore ] && [ -f .betterleaksignore ]; then continue; fi
            # The contents API reads the default branch when given no ref. A
            # failed or cut-short download, after the retries, reports as 000.
            status=$(curl -sSL --retry 3 --retry-all-errors -o "$f" -w '%{http_code}' \
              -H "Authorization: Bearer $GH_TOKEN" \
              -H 'Accept: application/vnd.github.raw' \
              "$GITHUB_API_URL/repos/$REPO/contents/$f") || status=000
            case "$status" in
              200) echo "Using main's $f" ;;
              404) rm -f "$f" ;;
              *) echo "::error::Could not read $f from main (HTTP $status)"; exit 1 ;;
            esac
          done
          if [ ! -f .betterleaks.toml ]; then
            printf '[extend]\nuseDefault = true\n' > .betterleaks.toml
            echo "main has no .betterleaks.toml; using the default rules alone"
          elif python3 -c 'import sys, tomllib; sys.exit(0 if tomllib.load(open(".betterleaks.toml", "rb")).get("extend", {}).get("path") else 1)'; then
            # An extended file would be read from the checkout, not from main.
            echo "::error::main's .betterleaks.toml uses [extend] path, which this step can't take from main"
            exit 1
          fi
          # The config must still find a secret: one without the default rules,
          # or with a filter that drops everything, would pass every run. The
          # planted value is random, so no secret-shaped literal sits here.
          # --exit-code 3 tells a finding apart from a config that fails to
          # load, which exits 1.
          canary="$RUNNER_TEMP/canary"
          mkdir -p "$canary"
          printf 'db_password = "%s"\n' "$(head -c 48 /dev/urandom | base64 | tr -dc 'A-Za-z0-9' | head -c 24)" \
            > "$canary/canary.py"
          rc=0
          "$RUNNER_TEMP/betterleaks" dir "$canary" --config .betterleaks.toml --exit-code 3 \
            --no-banner > /dev/null 2>&1 || rc=$?
          case "$rc" in
            3) ;;
            0) echo "::error::main's .betterleaks.toml lets a planted secret through, so the scan would pass anything"; exit 1 ;;
            *) echo "::error::main's .betterleaks.toml could not be used (betterleaks exit $rc)"; exit 1 ;;
          esac
          rc=0
          "$RUNNER_TEMP/betterleaks" dir "$submitted" --config .betterleaks.toml --exit-code 3 \
            --ignore-gitleaks-allow --redact --verbose --no-banner || rc=$?
          case "$rc" in
            0) ;;
            3) echo "::error::A suppression file in the checkout holds what looks like a secret"; exit 1 ;;
            *) echo "::error::Could not scan the checkout's suppression files (betterleaks exit $rc)"; exit 1 ;;
          esac

      - name: Scan git history
        # The suppression files are main's by now (above).
        run: |
          "$RUNNER_TEMP/betterleaks" git --config .betterleaks.toml \
            --ignore-gitleaks-allow --redact --verbose --no-banner .

  trivy:
    name: Vulnerabilities (Trivy)
    runs-on: ubuntu-latest
    env:
      # One database for both scans: the action is handed this path as its
      # cache-dir, and the base scan reads it through the variable.
      TRIVY_CACHE_DIR: ${{ github.workspace }}/.cache/trivy
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false
          # A PR checks out its merge commit; depth 2 brings the first parent,
          # the base it merges into, which the gate scans as its baseline.
          fetch-depth: 2
      - name: Scan dependencies and Dockerfile
        uses: aquasecurity/trivy-action@ed142fd0673e97e23eac54620cfb913e5ce36c25 # v0.36.0
        with:
          scan-type: fs
          scan-ref: .
          trivy-config: trivy.yaml
          version: v0.76.2
          cache-dir: ${{ env.TRIVY_CACHE_DIR }}
          format: json
          output: trivy-results.json
          # The next step decides which findings fail the job.
          exit-code: '0'
      # Trivy's advisory database moves independently of the code: an advisory
      # published against a lockfile nobody touched would turn every open PR
      # red at once. So a PR fails only on findings its base lacks, matched by
      # file, package and advisory (or misconfiguration check), and the findings
      # the base already had surface as warnings. The version is not part of the
      # match: a package moved to another version the same advisory covers was
      # exposed to it before the PR too.
      #
      # The base is scanned with its own trivy.yaml and .trivyignore, so a PR
      # that widens the policy fails on what that uncovers; one that narrows it
      # passes, and that change shows only in the diff.
      #
      # A manual run has no baseline and fails on every finding, as do the
      # weekly and push-to-main scans in security.yml, so a new advisory still
      # turns main red without blocking unrelated PRs.
      - name: Gate on findings the change introduces
        env:
          EVENT: ${{ github.event_name }}
        run: |[[- trivy_gate(is_pr='[ "$EVENT" = "pull_request" ]', tmp='$RUNNER_TEMP', warning='::warning title=Trivy::') ]]

  # Aggregate gate for branch protection. Passes when every job succeeded or was
  # skipped; fails otherwise. Set this ("CI") as the required status check.
  ci:
    name: CI
    if: always()
    needs: [lint, test, lowest-direct, pre-commit, betterleaks, trivy]
    runs-on: ubuntu-latest
    steps:
      - name: Verify all jobs passed
        env:
          # Every job in `needs`, so a job added there is checked automatically.
          RESULTS: ${{ join(needs.*.result, ' ') }}
        run: |
          for r in $RESULTS; do
            if [ "$r" != "success" ] && [ "$r" != "skipped" ]; then
              echo "Job failed: $r"
              exit 1
            fi
          done
          echo "All jobs passed"
