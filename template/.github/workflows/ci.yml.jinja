# CI — lint, run the test suite, and guard the declared dependency floor.
#
# The project targets a single Python version, [[ python_version ]] (the
# template's `python_version`; the dev container uses the same one). To move
# to a newer Python, bump it in the template and run `copier update`, which
# updates this file, requires-python, the classifiers, ruff's target-version,
# and the dev container together.
#
# `lowest-direct` installs the *lowest* versions allowed by our direct
# dependency constraints (uv --resolution lowest-direct) and runs the suite, so
# a dependency floor that's too low fails here instead of in an install.
#
# Security scanning:
# - `pre-commit` runs every hook in .pre-commit-config.yaml (Semgrep SAST,
#   actionlint, zizmor) over the whole tree, so CI enforces exactly what the
#   local hooks check.
# - `betterleaks` scans the full git history for secrets (the local hook only
#   sees staged changes).
# - `trivy` scans uv.lock for vulnerable dependencies and the Dockerfile for
#   misconfigurations (config in trivy.yaml). On a pull request it fails only
#   on findings the base branch lacks, so a newly published advisory doesn't
#   fail every open PR at once.
# Trivy and Semgrep also run weekly and on every push to main (security.yml),
# which uploads their findings to the Security tab and opens an issue when a
# run fails.
#
# Every action is pinned to a full commit SHA (tag in a trailing comment), not
# a mutable tag: in March 2026 an attacker repointed 76 of trivy-action's 77
# tags at credential-stealing code. Dependabot keeps the SHAs current.
#
# `ci` is an aggregate gate job: make THIS the required status check in branch
# protection. It reports a single stable name ("CI") regardless of how many jobs
# or matrix legs exist, so changing them never breaks branch protection config.

name: CI

on:
  pull_request:
  workflow_dispatch:

permissions:
  contents: read

jobs:
  lint:
    name: Lint (ruff)
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false
      - uses: astral-sh/setup-uv@1c37ad07a6a961277cf70c0d37d6f313000f5884 # v10.3.0
        with:
          python-version: '[[ python_version ]]'
      # --locked fails when uv.lock is out of date with pyproject.toml
      # (--frozen would install the stale lock and `uv run` would re-lock).
      - name: Install dependencies
        run: uv sync --locked --all-extras
      - name: Ruff format check
        run: uv run ruff format --check .
      - name: Ruff lint
        run: uv run ruff check .

  test:
    name: Test
    needs: lint
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false
      - uses: astral-sh/setup-uv@1c37ad07a6a961277cf70c0d37d6f313000f5884 # v10.3.0
        with:
          python-version: '[[ python_version ]]'
      # --locked fails when uv.lock is out of date with pyproject.toml
      # (--frozen would install the stale lock and `uv run` would re-lock).
      - name: Install dependencies
        run: uv sync --locked --all-extras
[%- if flavor == 'browser' %]
      # Playwright's browser isn't a Python package, so `uv sync` leaves it
      # out. The cache holds the download (keyed on the lockfile, which pins
      # the Playwright version); --with-deps still apt-installs the libraries
      # Chromium needs on each run.
      - name: Cache Playwright browsers
        uses: actions/cache@55cc8345863c7cc4c66a329aec7e433d2d1c52a9 # v6.1.0
        with:
          path: ~/.cache/ms-playwright
          key: playwright-locked-${{ runner.os }}-${{ hashFiles('uv.lock') }}
      - name: Install Playwright's Chromium
        run: uv run --no-sync playwright install --with-deps chromium
[%- endif %]
      - name: Test
        run: uv run pytest

  lowest-direct:
    name: Test (lowest-direct floor)
    needs: lint
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false
      - uses: astral-sh/setup-uv@1c37ad07a6a961277cf70c0d37d6f313000f5884 # v10.3.0
        with:
          python-version: '[[ python_version ]]'
      - name: Install lowest allowed direct dependencies
        run: uv sync --resolution lowest-direct --all-extras
[%- if flavor == 'browser' %]
      # Playwright's browser isn't a Python package, so `uv sync` leaves it
      # out. The cache holds the download (keyed on the lockfile, which pins
      # the Playwright version); --with-deps still apt-installs the libraries
      # Chromium needs on each run.
      - name: Cache Playwright browsers
        uses: actions/cache@55cc8345863c7cc4c66a329aec7e433d2d1c52a9 # v6.1.0
        with:
          path: ~/.cache/ms-playwright
          key: playwright-lowest-direct-${{ runner.os }}-${{ hashFiles('uv.lock') }}
      - name: Install Playwright's Chromium
        run: uv run --no-sync playwright install --with-deps chromium
[%- endif %]
      # --no-sync: a plain `uv run` would re-lock at the default (highest)
      # resolution and reinstall, testing the newest versions instead.
      - name: Test
        run: uv run --no-sync pytest

  pre-commit:
    name: Pre-commit hooks
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false
      - uses: astral-sh/setup-uv@1c37ad07a6a961277cf70c0d37d6f313000f5884 # v10.3.0
        with:
          python-version: '[[ python_version ]]'
      # Only the dev group (pre-commit itself): the hooks run in their own
      # environments, so the package and its runtime deps aren't needed.
      - name: Install dependencies
        run: uv sync --frozen --only-dev
      # The Python hook envs (Semgrep, zizmor) link to this interpreter, so the
      # cache key includes its version: otherwise a Python patch bump restores
      # broken envs that pre-commit rebuilds on every run, and an exact key hit
      # never re-saves the cache.
      - name: Get Python version
        id: python
        run: echo "version=$(uv run --frozen --only-dev python -c 'import sys; print(sys.version.split()[0])')" >> "$GITHUB_OUTPUT"
      - name: Cache hook environments
        uses: actions/cache@55cc8345863c7cc4c66a329aec7e433d2d1c52a9 # v6.1.0
        with:
          path: ~/.cache/pre-commit
          key: pre-commit-${{ runner.os }}-py${{ steps.python.outputs.version }}-${{ hashFiles('.pre-commit-config.yaml') }}
      # The betterleaks hook only scans staged changes, so it has nothing to do
      # here; the `betterleaks` job below scans the full history instead.
      - name: Run hooks on all files
        run: uv run --frozen --only-dev pre-commit run --all-files --show-diff-on-failure
        env:
          SKIP: betterleaks
          # Enables zizmor's online audits (e.g. that each pinned SHA belongs to
          # the repo it claims). Read-only: the workflow grants contents: read.
          GH_TOKEN: ${{ github.token }}

  betterleaks:
    name: Secrets (Betterleaks)
    runs-on: ubuntu-latest
    env:
      # Keep in step with the betterleaks rev in .pre-commit-config.yaml (the
      # first step fails the job when they differ, e.g. after a Dependabot hook
      # bump). To bump: update both, and take the linux_x64 sha256 from the
      # release's checksums.txt.
      BETTERLEAKS_VERSION: 1.9.0
      BETTERLEAKS_SHA256: f8b185a39ffcece2a1ca82bf3a4e7435cd81963ffd16b7a9128daf75f35f6de7
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false
          fetch-depth: 0 # full history: a secret removed in a later commit is still leaked
      - name: Check version matches the pre-commit hook
        run: |
          if ! grep -A1 'repo: https://github.com/betterleaks/betterleaks$' .pre-commit-config.yaml \
              | grep -q "# frozen: v${BETTERLEAKS_VERSION//./\\.}\$"; then
            echo "::error::BETTERLEAKS_VERSION (${BETTERLEAKS_VERSION}) does not match the betterleaks rev in .pre-commit-config.yaml; bump BETTERLEAKS_VERSION and BETTERLEAKS_SHA256"
            exit 1
          fi
      - name: Install Betterleaks
        run: |
          tarball="betterleaks_${BETTERLEAKS_VERSION}_linux_x64.tar.gz"
          curl -fsSLO "https://github.com/betterleaks/betterleaks/releases/download/v${BETTERLEAKS_VERSION}/${tarball}"
          echo "${BETTERLEAKS_SHA256}  ${tarball}" | sha256sum -c -
          tar -xzf "$tarball" betterleaks
      - name: Scan git history
        run: ./betterleaks git --redact --verbose --no-banner .

  trivy:
    name: Vulnerabilities (Trivy)
    runs-on: ubuntu-latest
    env:
      # One database for both scans: the action is handed this path as its
      # cache-dir, and the base scan reads it through the variable.
      TRIVY_CACHE_DIR: ${{ github.workspace }}/.cache/trivy
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false
          # A PR checks out its merge commit; depth 2 brings the first parent,
          # the base it merges into, which the gate scans as its baseline.
          fetch-depth: 2
      - name: Scan dependencies and Dockerfile
        uses: aquasecurity/trivy-action@ed142fd0673e97e23eac54620cfb913e5ce36c25 # v0.36.0
        with:
          scan-type: fs
          scan-ref: .
          trivy-config: trivy.yaml
          version: v0.75.0
          cache-dir: ${{ env.TRIVY_CACHE_DIR }}
          format: json
          output: trivy-results.json
          # The next step decides which findings fail the job.
          exit-code: '0'
      # Trivy's advisory database moves independently of the code: an advisory
      # published against a lockfile nobody touched would turn every open PR
      # red at once. So a PR fails only on findings its base lacks, matched by
      # file, package and advisory (or misconfiguration check), and the findings
      # the base already had surface as warnings. The version is not part of the
      # match: a package moved to another version the same advisory covers was
      # exposed to it before the PR too.
      #
      # The base is scanned with its own trivy.yaml and .trivyignore, so a PR
      # that widens the policy fails on what that uncovers; one that narrows it
      # passes, and that change shows only in the diff.
      #
      # A manual run has no baseline and fails on every finding, as do the
      # weekly and push-to-main scans in security.yml, so a new advisory still
      # turns main red without blocking unrelated PRs.
      - name: Gate on findings the change introduces
        env:
          EVENT: ${{ github.event_name }}
        run: |
          count='[.Results[]? | (.Vulnerabilities[]?, .Misconfigurations[]?)] | length'
          if [ "$(jq "$count" trivy-results.json)" -eq 0 ]; then
            echo "No finding under the policy in trivy.yaml."
            exit 0
          fi

          if [ "$EVENT" = "pull_request" ]; then
            git worktree add --detach "$RUNNER_TEMP/base" HEAD^1
            # The database and checks the first scan downloaded, unchanged, so
            # both reports describe the same set of advisories.
            (cd "$RUNNER_TEMP/base" && trivy fs --skip-db-update --skip-check-update \
              --format json --output "$GITHUB_WORKSPACE/trivy-base.json" --exit-code 0 .)
          else
            echo '{}' > trivy-base.json
          fi

          # Splits each file's findings into those the base already had, counted
          # for the warnings, and the rest, which stay in the report.
          jq --slurpfile base trivy-base.json '
            def key($t): "\($t)|\(.PkgName // "")|\(.VulnerabilityID // .ID)";
            def drop_known($t; $old): if . then map(select($old[key($t)] | not)) else . end;
            (reduce ($base[0].Results[]? | .Target as $t
                | (.Vulnerabilities[]?, .Misconfigurations[]?) | key($t))
              as $k ({}; .[$k] = true)) as $old
            | .Baseline = [.Results[]? | .Target as $t
                | {Target: $t, Count: ([(.Vulnerabilities[]?, .Misconfigurations[]?)
                    | select($old[key($t)])] | length)}
                | select(.Count > 0)]
            | .Results |= [.[]? | .Target as $t
                | .Vulnerabilities |= drop_known($t; $old)
                | .Misconfigurations |= drop_known($t; $old)]
          ' trivy-results.json > trivy-gated.json

          jq -r '.Baseline[] | "::warning title=Trivy::\(.Target) carries \(.Count) findings its base already had"' trivy-gated.json

          if [ "$(jq "$count" trivy-gated.json)" -gt 0 ]; then
            trivy convert --format table trivy-gated.json
            exit 1
          fi
          echo "No finding under the policy in trivy.yaml that the base lacks."

  # Aggregate gate for branch protection. Passes when every job succeeded or was
  # skipped; fails otherwise. Set this ("CI") as the required status check.
  ci:
    name: CI
    if: always()
    needs: [lint, test, lowest-direct, pre-commit, betterleaks, trivy]
    runs-on: ubuntu-latest
    steps:
      - name: Verify all jobs passed
        env:
          # Every job in `needs`, so a job added there is checked automatically.
          RESULTS: ${{ join(needs.*.result, ' ') }}
        run: |
          for r in $RESULTS; do
            if [ "$r" != "success" ] && [ "$r" != "skipped" ]; then
              echo "Job failed: $r"
              exit 1
            fi
          done
          echo "All jobs passed"
